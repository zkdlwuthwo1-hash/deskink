<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Device identity and pairing tokens belong to this tablet only. -->
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
